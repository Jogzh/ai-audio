{
  "name": "ai-audio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Original emotional pop, cinematic Chinese music and offline MP3/WAV rendering with Tone.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jogzh/ai-audio.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "node scripts/check-browser.mjs && node scripts/check-guofeng.mjs && node scripts/check-guofeng.mjs --ink-tide && node scripts/check-multitrack.mjs && node scripts/check-guofeng.mjs --neon-changan && node scripts/check-guofeng.mjs --vocal",
    "check": "npm test && npm run build",
    "render": "node scripts/render.mjs",
    "render:neon": "node scripts/render.mjs --track neon-changan --seed 261014 --sample-rate 48000 --bit-depth 24 --format both --master loudness",
    "package:neon": "node scripts/package-neon-changan.mjs",
    "render:vocal": "node scripts/render.mjs --track neon-changan-vocal --seed 261014 --sample-rate 48000 --bit-depth 24 --format both --master loudness",
    "render:stems": "node scripts/render-stems.mjs"
  },
  "dependencies": {
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}

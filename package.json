{
  "name": "ai-audio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tone.js 音乐生成、声音配方与离线音频导出实验框架",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jogzh/ai-audio.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:palette": "node scripts/check-palette.mjs",
    "check": "npm test && npm run build",
    "render": "node scripts/render.mjs"
  },
  "dependencies": {
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
